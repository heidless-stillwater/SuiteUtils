def get_workspace_path():
    """Detects the real workspace path dynamically based on script location."""
    return os.path.realpath(os.path.dirname(os.path.abspath(__file__)))

def get_conversations(workspace_path):
    """
    Scans database files associated with the current workspace.
    Returns a list of dicts: {conv_id, mtime, db_path, is_active}
    """
    workspace_uri = f"file://{workspace_path}"
    db_files = glob.glob(os.path.join(CONVS_DIR, "*.db"))
    
    results = []
    active_id = None
    latest_mtime = -1
    
    # First pass: find the absolute latest modified db file to determine active session
    for db_path in db_files:
        try:
            mtime = os.path.getmtime(db_path)
            if mtime > latest_mtime:
                latest_mtime = mtime
                active_id = os.path.basename(db_path)[:-3]
        except Exception:
            pass

    for db_path in db_files:
        conv_id = os.path.basename(db_path)[:-3]
        try:
            conn = sqlite3.connect(db_path)
            cursor = conn.cursor()
            cursor.execute('SELECT data FROM trajectory_metadata_blob WHERE id="main";')
            row = cursor.fetchone()
            conn.close()
            
            if row:
                data = row[0]
                # Check if workspace URI is present in the protobuf-like binary blob
                if workspace_uri.encode('utf-8') in data:
                    results.append({
                        "conv_id": conv_id,
                        "mtime": os.path.getmtime(db_path),
                        "db_path": db_path,
                        "is_active": (conv_id == active_id)
                    })
        except Exception:
            pass
            
    # Sort by mtime descending (most recently updated first)
    results.sort(key=lambda x: x["mtime"], reverse=True)
    return results

def clean_user_content(content):
    """Extracts only the actual user request from inside the XML-like tags."""
    if not content:
        return ""
    # Try to find content inside <USER_REQUEST> tags
    match = re.search(r'<USER_REQUEST>(.*?)</USER_REQUEST>', content, re.DOTALL)
    if match:
        return match.group(1).strip()
    return content.strip()

def parse_transcript(conv_id):
    """
    Parses transcript.jsonl if it exists.
    Returns: (messages, last_mtime)
    messages is a list of dicts: {role, content, actions, timestamp}
    """
    transcript_path = os.path.join(BRAIN_DIR, conv_id, ".system_generated/logs/transcript.jsonl")
    if not os.path.exists(transcript_path):
        return [], None
        
    messages = []
    current_actions = []
    
    try:
        with open(transcript_path, 'r', encoding='utf-8') as f:
            for line in f:
                if not line.strip():
                    continue
                step = json.loads(line)
                step_type = step.get("type")
                source = step.get("source")
                created_at = step.get("created_at")
                
                # Check for tool calls / actions
                if step_type == "PLANNER_RESPONSE" and source == "MODEL" and step.get("tool_calls"):
                    for tc in step["tool_calls"]:
                        name = tc.get("name")
                        args = tc.get("args") or {}
                        
                        # Clean arguments (sometimes they are json string encoded)
                        cleaned_args = {}
                        for k, v in args.items():
                            if isinstance(v, str) and v.startswith('"') and v.endswith('"'):
                                try:
                                    cleaned_args[k] = json.loads(v)
                                except Exception:
                                    cleaned_args[k] = v.strip('"')
                            else:
                                cleaned_args[k] = v

                        action_str = ""
                        if name == "run_command":
                            action_str = f"💻 Run command: `{cleaned_args.get('CommandLine')}`"
                        elif name in ["replace_file_content", "multi_replace_file_content", "write_to_file"]:
                            target = cleaned_args.get("TargetFile") or "file"
                            action_str = f"📝 Edit/create file: `{os.path.basename(target)}`"
                        elif name == "view_file":
                            target = cleaned_args.get("AbsolutePath") or "file"
                            action_str = f"🔍 View file: `{os.path.basename(target)}`"
                        elif name == "grep_search":
                            action_str = f"🔎 Search files for: `{cleaned_args.get('Query')}`"
                        elif name == "list_dir":
                            action_str = f"📁 List directory: `{os.path.basename(cleaned_args.get('DirectoryPath') or '')}`"
                        else:
                            action_str = f"🛠️ Tool call: `{name}`"
                        
                        current_actions.append(action_str)
                
                # Handle text entries
                if step_type == "USER_INPUT" and source == "USER_EXPLICIT":
                    raw_content = step.get("content") or ""
                    cleaned = clean_user_content(raw_content)
                    messages.append({
                        "role": "User",
                        "content": cleaned,
                        "actions": [],
                        "timestamp": created_at
                    })
                elif step_type == "PLANNER_RESPONSE" and source == "MODEL" and step.get("content"):
                    # This is actual text response to user
                    messages.append({
                        "role": "Antigravity",
                        "content": step["content"],
                        "actions": list(current_actions),
                        "timestamp": created_at
                    })
                    current_actions = [] # Clear action cache
    except Exception:
        pass
        
    return messages, os.path.getmtime(transcript_path)

