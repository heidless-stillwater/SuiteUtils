def cmd_activate(args):
    """Switches the active conversation session."""
    workspace = get_workspace_path()
    convs = get_conversations(workspace)
    target_id = args.conversation_id.strip()
    
    # Support partial matches/prefixes
    matched = [c for c in convs if c["conv_id"].startswith(target_id)]
    
    if not matched:
        print(f"{C_RED}{C_BOLD}Error: No matching conversation found for prefix '{target_id}'{C_RESET}")
        return
    elif len(matched) > 1:
        print(f"{C_YELLOW}Prefix is ambiguous. Multiple matching sessions found:{C_RESET}")
        for m in matched:
            print(f"  - {m['conv_id']}")
        return
        
    choice = matched[0]
    conv_id = choice["conv_id"]
    
    print(f"Activating conversation: {C_CYAN}{conv_id}{C_RESET}...")
    
    now = time.time()
    
    # Touch SQLite database files in conversations/
    db_file = os.path.join(CONVS_DIR, f"{conv_id}.db")
    for ext in ["", "-wal", "-shm"]:
        p = db_file + ext
        if os.path.exists(p):
            os.utime(p, (now, now))
            
    # Touch all files inside the brain directory
    brain_path = os.path.join(BRAIN_DIR, conv_id)
    if os.path.exists(brain_path):
        os.utime(brain_path, (now, now))
        for root, dirs, files in os.walk(brain_path):
            for d in dirs:
                os.utime(os.path.join(root, d), (now, now))
            for f in files:
                os.utime(os.path.join(root, f), (now, now))
                
    print(f"{C_GREEN}{C_BOLD}Success! Conversation {conv_id} is now set as the active session.{C_RESET}")
    print(f"{C_WHITE}Switching accounts or reopening the Antigravity chat panel will load this thread.{C_RESET}\n")

