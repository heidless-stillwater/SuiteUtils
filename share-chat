def cmd_share(args):
    """
    Duplicates and rebinds a conversation to share it with another Google profile (username/email),
    or grants access to all known profiles in-place.
    """
    import uuid
    import shutil
    
    workspace = get_workspace_path()
    convs = get_conversations(workspace)
    
    # 1. Resolve source conversation
    source_id = args.conversation_id
    if not source_id:
        active = next((c for c in convs if c["is_active"]), None)
        if not active:
            print(f"{C_RED}{C_BOLD}Error: No active conversation to share. Please specify an ID.{C_RESET}")
            return
        source_id = active["conv_id"]
    else:
        # Prefix match
