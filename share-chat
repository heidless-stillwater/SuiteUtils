        if not active:
            print(f"{C_RED}{C_BOLD}Error: No active conversation to export. Please specify an ID.{C_RESET}")
            return
        conv_id = active["conv_id"]
    else:
        # Check prefix match
        convs = get_conversations(workspace)
        matched = [c for c in convs if c["conv_id"].startswith(conv_id)]
