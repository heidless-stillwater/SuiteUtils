rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─────────────────────────────────────────────────────────
    // Shared Agent Sessions
    // Path: sessions/{userId}/{projectSlug}/{sessionId}
    //
    // Scoped rules override the wildcard below for this path.
    //   • Write: session owner only
    //   • Read:  any authenticated user (cross-account sharing)
    // ─────────────────────────────────────────────────────────
    match /sessions/{userId}/{projectSlug}/{sessionId} {
      allow read: if request.auth != null;

      allow create: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.userId == userId
        && request.resource.data.keys().hasAll(['sessionId', 'projectSlug', 'userId', 'displayName', 'updatedAt', 'files', 'history']);

      allow update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.history.size() >= resource.data.history.size();

      allow delete: if request.auth != null
        && request.auth.uid == userId;
    }

    // Sovereign Isolation: all other collections wide-open (protected by local identity)
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
