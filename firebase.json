{
  "firestore": [
    { "database": "persona-db-0", "rules": "sovereign.rules" },
    { "database": "prompttool-db-0", "rules": "sovereign.rules" },
    { "database": "promptresources-db-0", "rules": "sovereign.rules" },
    { "database": "promptmaster-spa-db-0", "rules": "sovereign.rules" },
    { "database": "promptaccreditation-db-0", "rules": "sovereign.rules" },
    { "database": "plantune-db-0", "rules": "sovereign.rules" },
    { "database": "suiteutils-db-0", "rules": "sovereign.rules", "indexes": "firestore.indexes.json" },
    { "database": "autovideo-db-0", "rules": "sovereign.rules" },
    { "database": "urlshortener-db-0", "rules": "sovereign.rules" },
    { "database": "(default)", "rules": "firestore.rules" }
  ],
  "hosting": {
    "target": "stillwater-suite-utils",
    "public": "dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}
