rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Users collection — users can read/write their own profile
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      allow read: if request.auth != null;
    }

    // Suites collection — owner can read/write, authenticated users can read
    match /suites/{suiteId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null && resource.data.ownerId == request.auth.uid;
    }

    // Deployments collection
    match /deployments/{deployId} {
      allow read, write: if request.auth != null;
    }

    // System Configuration & Global Secrets
    match /system/{document=**} {
      allow read, write: if request.auth != null;
    }

    match /system_config/{document=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.token.role == 'admin';
    }

    // Safe System Config (Public Read)
    match /system_config/protection {
      allow read: if true;
    }
    match /system_config/moderation {
      allow read: if true;
    }

    // ─────────────────────────────────────────────────
    // Shared Agent Sessions
    // Structure: sessions/{userId}/{projectSlug}/{sessionId}
    //
    // • Write: only the owning user
    // • Read:  any authenticated user (cross-account sharing)
    // ─────────────────────────────────────────────────
    match /users/{userId}/sessions/{sessionId} {
      // Any authenticated user can read any session
      allow read: if request.auth != null;

      // Only the owning user can create or update their sessions
      allow create: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.userId == userId
        && request.resource.data.keys().hasAll(['sessionId', 'projectSlug', 'userId', 'displayName', 'updatedAt', 'files', 'history']);

      allow update: if request.auth != null
        && request.auth.uid == userId
        // History must only grow (append-only — no deletions from history array)
        && request.resource.data.history.size() >= resource.data.history.size();

      // Only owner can delete
      allow delete: if request.auth != null
        && request.auth.uid == userId;
    }
  }
}
